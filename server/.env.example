# ============================================================================
# MUREEH SERVER — environment configuration
# Copy this file to ".env" for local development
# (cp .env.example .env), or set these as environment variables directly in
# your Render service settings for production. Never commit a real ".env"
# file with live secrets to git.
# ============================================================================

# ---- Database (required) ----------------------------------------------------
# Your Supabase Postgres connection string.
# Find it in: Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> URI (choose "Session pooler" or "Transaction pooler"
# mode for best compatibility with Render's networking).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Set to "disable" only for a local Postgres that doesn't use SSL.
# Leave unset (or "require") for Supabase — Supabase always requires SSL.
# PGSSL=disable

# ---- Auth (required) --------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: changing this invalidates all existing logged-in sessions.
JWT_SECRET=replace_with_a_long_random_string

# Seed admin account, created automatically on first boot if it doesn't
# already exist in the database.
MUREEH_ADMIN_USER=mureeh_admin
MUREEH_ADMIN_PASS=change_this_password

# ---- Image storage (recommended for production) -----------------------------
# Render's disk is EPHEMERAL — uploaded images stored on local disk are lost
# on every deploy/restart. Set these to store project images in Supabase
# Storage instead (a bucket named below will need to exist and be public,
# see server/README.md for the one-time setup).
# If left unset, the app falls back to local disk storage under
# mureeh-site/uploads — fine for local development only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=project-images

# ---- Misc --------------------------------------------------------------------
PORT=4000
